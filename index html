    <!-- JavaScript Application Logic -->
    <script>
        // Initial Mock Data
        let products = JSON.parse(localStorage.getItem('dental_products')) || [
            { id: 1, name: "جهاز فحص أسنان LED ناصع", price: 3500, category: "devices", img: "https://images.unsplash.com/photo-1588776814546-1ffcf47267a5?w=300" },
            { id: 2, name: "طقم حشوات كومبوزيت متكامل", price: 1200, category: "fillings", img: "https://images.unsplash.com/photo-1606811841689-23dfddce3e95?w=300" },
            { id: 3, name: "أدوات تقويم أسنان معدنية (Pack)", price: 850, category: "ortho", img: "https://images.unsplash.com/photo-1598256989800-fe5f95da9787?w=300" },
            { id: 4, name: "جهاز تعقيم أوتوكلاف 18 لتر", price: 18500, category: "sterilization", img: "https://images.unsplash.com/photo-1583947215259-38e31be8751f?w=300" }
        ];

        let cart = JSON.parse(localStorage.getItem('dental_cart')) || [];
        let orders = JSON.parse(localStorage.getItem('dental_orders')) || [];
        let users = JSON.parse(localStorage.getItem('dental_users')) || [
            { username: "admin", role: "admin" }
        ];

        let currentUser = JSON.parse(localStorage.getItem('dental_current_user')) || null;
        let currentCategory = 'all';
        let authMode = 'login';

        // Save State
        function saveData() {
            localStorage.setItem('dental_products', JSON.stringify(products));
            localStorage.setItem('dental_cart', JSON.stringify(cart));
            localStorage.setItem('dental_orders', JSON.stringify(orders));
            localStorage.setItem('dental_users', JSON.stringify(users));
            localStorage.setItem('dental_current_user', JSON.stringify(currentUser));
        }

        // Initialize App
        function init() {
            renderProducts();
            updateCartUI();
            updateUserNav();
            renderAdminData();
        }

        // Render Products Grid
        function renderProducts() {
            const container = document.getElementById('productsSection');
            const filtered = products.filter(p => {
                const matchesCat = currentCategory === 'all' || p.category === currentCategory;
                const searchVal = document.getElementById('searchInput').value.toLowerCase();
                const matchesSearch = p.name.toLowerCase().includes(searchVal);
                return matchesCat && matchesSearch;
            });

            container.innerHTML = filtered.map(p => `
                <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden hover:shadow-md transition">
                    <img src="${p.img}" alt="${p.name}" class="w-full h-48 object-cover">
                    <div class="p-4">
                        <h3 class="font-bold text-gray-800 text-sm mb-2">${p.name}</h3>
                        <div class="flex justify-between items-center">
                            <span class="text-medical-700 font-extrabold">${p.price.toLocaleString()} ج.م</span>
                            <button onclick="addToCart(${p.id})" class="bg-medical-50 text-medical-700 p-2 rounded-lg hover:bg-medical-600 hover:text-white transition">
                                <i class="fa-solid fa-plus"></i>
                            </button>
                        </div>
                    </div>
                </div>
            `).join('');
        }

        // Category Filter
        function setCategory(cat) {
            currentCategory = cat;
            document.querySelectorAll('.cat-btn').forEach(btn => {
                btn.classList.remove('bg-medical-600', 'text-white');
                btn.classList.add('bg-white', 'text-gray-700');
            });
            event.target.classList.add('bg-medical-600', 'text-white');
            renderProducts();
        }

        function filterProducts() {
            renderProducts();
        }

        // Cart Actions
        function addToCart(productId) {
            const product = products.find(p => p.id === productId);
            const item = cart.find(i => i.id === productId);
            if (item) {
                item.qty += 1;
            } else {
                cart.push({ ...product, qty: 1 });
            }
            saveData();
            updateCartUI();
        }

        function updateCartUI() {
            document.getElementById('cartBadge').innerText = cart.reduce((acc, i) => acc + i.qty, 0);
            const container = document.getElementById('cartItems');
            container.innerHTML = cart.map(i => `
                <div class="flex items-center justify-between border-b pb-3">
                    <div>
                        <h4 class="font-bold text-xs text-gray-800">${i.name}</h4>
                        <span class="text-xs text-medical-600 font-bold">${(i.price * i.qty).toLocaleString()} ج.م</span>
                    </div>
                    <div class="flex items-center space-x-2 space-x-reverse">
                        <button onclick="changeQty(${i.id}, -1)" class="px-2 py-1 bg-gray-100 rounded">-</button>
                        <span class="text-xs font-bold">${i.qty}</span>
                        <button onclick="changeQty(${i.id}, 1)" class="px-2 py-1 bg-gray-100 rounded">+</button>
                    </div>
                </div>
            `).join('');

            const total = cart.reduce((acc, i) => acc + (i.price * i.qty), 0);
            document.getElementById('cartTotal').innerText = total.toLocaleString() + ' ج.م';
        }

        function changeQty(id, delta) {
            const item = cart.find(i => i.id === id);
            if (item) {
                item.qty += delta;
                if (item.qty <= 0) cart = cart.filter(i => i.id !== id);
            }
            saveData();
            updateCartUI();
        }

        function toggleCart() {
            document.getElementById('cartDrawer').classList.toggle('hidden');
        }

        function checkout() {
            if (cart.length === 0) return alert('السلة فارغة!');
            const order = {
                id: Date.now(),
                customer: currentUser ? currentUser.username : "طبيب زائر",
                total: cart.reduce((acc, i) => acc + (i.price * i.qty), 0),
                status: "قيد الانتظار"
            };
            orders.push(order);
            cart = [];
            saveData();
            updateCartUI();
            toggleCart();
            alert('تم تسجيل طلبك بنجاح! سيتواصل معك الدعم الفني قريباً.');
            renderAdminData();
        }

        // Authentication Logic
        function openAuthModal(mode) {
            authMode = mode;
            document.getElementById('authModal').classList.remove('hidden');
            document.getElementById('authTitle').innerText = mode === 'login' ? 'تسجيل الدخول' : 'إنشاء حساب جديد';
            document.getElementById('roleSelectContainer').classList.toggle('hidden', mode === 'login');
        }

        function closeAuthModal() {
            document.getElementById('authModal').classList.add('hidden');
        }

        function toggleAuthMode() {
            openAuthModal(authMode === 'login' ? 'register' : 'login');
        }

        function handleAuth(e) {
            e.preventDefault();
            const username = document.getElementById('authUsername').value;
            const role = document.getElementById('authRole').value;

            if (authMode === 'register') {
                users.push({ username, role });
                currentUser = { username, role };
            } else {
                const user = users.find(u => u.username === username);
                if (user) {
                    currentUser = user;
                } else {
                    currentUser = { username, role: 'customer' };
                }
            }
            saveData();
            updateUserNav();
            closeAuthModal();
        }

        function updateUserNav() {
            const container = document.getElementById('userStatusNav');
            const adminBtn = document.getElementById('adminTabBtn');
            if (currentUser) {
                container.innerHTML = `
                    <span>مرحباً، <strong>${currentUser.username}</strong></span>
                    <button onclick="logout()" class="text-red-300 hover:underline me-2">خروج</button>
                `;
                adminBtn.classList.toggle('hidden', currentUser.role !== 'admin');
            } else {
                container.innerHTML = `
                    <button onclick="openAuthModal('login')" class="hover:underline"><i class="fa-solid fa-right-to-bracket me-1"></i> تسجيل الدخول</button>
                    <span>|</span>
                    <button onclick="openAuthModal('register')" class="hover:underline"><i class="fa-solid fa-user-plus me-1"></i> إنشاء حساب</button>
                `;
                adminBtn.classList.add('hidden');
            }
        }

        function logout() {
            currentUser = null;
            saveData();
            updateUserNav();
            switchTab('store');
        }

        // Navigation Switcher
        function switchTab(tab) {
            document.getElementById('storeView').classList.toggle('hidden', tab !== 'store');
            document.getElementById('adminView').classList.toggle('hidden', tab !== 'admin');
        }

        // Admin Functionality
        function renderAdminData() {
            document.getElementById('adminTotalRevenue').innerText = orders.reduce((acc, o) => acc + o.total, 0).toLocaleString() + ' ج.م';
            document.getElementById('adminOrdersCount').innerText = orders.length;
            document.getElementById('adminProductsCount').innerText = products.length;
            document.getElementById('adminUsersCount').innerText = users.length;

            const table = document.getElementById('adminOrdersTable');
            table.innerHTML = orders.map(o => `
                <tr class="bg-white border-b">
                    <td class="px-4 py-3 font-bold">#${o.id}</td>
                    <td class="px-4 py-3">${o.customer}</td>
                    <td class="px-4 py-3">01140188714</td>
                    <td class="px-4 py-3 text-medical-700 font-bold">${o.total.toLocaleString()} ج.م</td>
                    <td class="px-4 py-3"><span class="bg-amber-100 text-amber-800 text-xs px-2 py-1 rounded">${o.status}</span></td>
                </tr>
            `).join('');
        }

        function handleAddProduct(e) {
            e.preventDefault();
            const newProd = {
                id: Date.now(),
                name: document.getElementById('newProdName').value,
                price: parseFloat(document.getElementById('newProdPrice').value),
                category: document.getElementById('newProdCategory').value,
                img: document.getElementById('newProdImg').value || "https://images.unsplash.com/photo-1588776814546-1ffcf47267a5?w=300"
            };
            products.push(newProd);
            saveData();
            renderProducts();
            renderAdminData();
            e.target.reset();
            alert('تمت إضافة المنتج بنجاح!');
        }

        // Kickstart
        init();
    </script>
</body>
</html>
